# Offline defaults. Copying this file is optional; no credentials are needed.
DATABASE_URL=sqlite+aiosqlite:///./data/tradepulse.db
USE_MOCK_AI=true
DEMO_ENABLED=false
DEMO_DEFAULT_MODE=simulated
META_LIVE_ENABLED=false
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_CONNECT_TIMEOUT=5
META_READ_TIMEOUT=20
META_TOTAL_TIMEOUT=30
META_MAX_RESPONSE_BYTES=65536
META_MAX_REQUEST_BYTES=16384
META_MAX_OUTPUT_TOKENS=2048
META_MAX_CONCURRENCY=1
META_MAX_CALLS=3
META_MAX_TOTAL_TOKENS=60000
META_MAX_RETRIES=0
# MODEL_API_KEY must be supplied server-side only after separate live approval.
